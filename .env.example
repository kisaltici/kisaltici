# Frontend Application URL (Canonical domain for metadata, sharing, and self-references)
# Local Development: http://localhost:5173
# Production: https://kisaltici.com
VITE_APP_URL=http://localhost:5173

# Optional: API Base URL (leave unset or empty in production for unified same-origin /api/ routing)
# Local Development: http://localhost:5000 (default fallback)
# Production: (empty string / not needed on Vercel)
# VITE_API_BASE_URL=http://localhost:5000

# Firebase Web Client Configuration (Public client-side SDK configuration)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
