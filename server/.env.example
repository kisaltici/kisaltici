# Server Port (Local development only; Vercel assigns serverless execution automatically)
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/urlshortener?retryWrites=true&w=majority

# Short URL Domain (Base URL used when generating and displaying short links)
# Local Development: http://localhost:5000
# Production: https://lnk1.tr
BASE_URL=http://localhost:5000

# Frontend Application Origin (Allowed for CORS & 404/503 error page return links)
# Local Development: http://localhost:5173
# Production: https://kisaltici.com
FRONTEND_URL=http://localhost:5173

# Firebase Admin Configuration (Used for verifying client auth ID tokens)
# Minimum required: FIREBASE_PROJECT_ID (supports public JWKS verification mode)
FIREBASE_PROJECT_ID=kisaltici-d0848
# Optional Service Account credentials (for explicit service account certification)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@kisaltici-d0848.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=20
