# Server Port (Local development only; Vercel assigns serverless execution automatically)
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/urlshortener?retryWrites=true&w=majority

# Short URL Domain (Base URL used when generating and displaying short links)
# Local Development: http://localhost:5000
# Production: https://lnk1.tr
BASE_URL=http://localhost:5000

# Frontend Application Origin (Allowed for CORS & 404/503 error page return links)
# Local Development: http://localhost:5173
# Production: https://kisaltici.com
FRONTEND_URL=http://localhost:5173

# Firebase Admin Configuration (Used for verifying client auth ID tokens)
# Minimum required: FIREBASE_PROJECT_ID (supports public JWKS verification mode)
FIREBASE_PROJECT_ID=kisaltici-d0848
# Optional Service Account credentials (for explicit service account certification)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@kisaltici-d0848.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=20

# Firebase UIDs (comma-separated) allowed to hold the reserved "admin" username (grants Pro)
ADMIN_UIDS=

# Emails treated as admin (must be Firebase-verified). Defaults to kisaltici@gmail.com
ADMIN_EMAILS=kisaltici@gmail.com

# PayTR (iFrame API). Get these from the PayTR merchant panel (Destek & Kurulum > Entegrasyon Bilgileri).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Test mode stays ON until you set this to 0 (live payments)
PAYTR_TEST_MODE=1
# Public site URL used for the PayTR success/fail return pages (defaults to https://kisaltici.com on Vercel)
# APP_URL=https://kisaltici.com
# Local development only: PayTR needs a public IPv4 for user_ip; set your external IP here when testing locally
# PAYTR_USER_IP_OVERRIDE=
